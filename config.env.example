# config.env — Конфигурация скилла SEO Article Writer
# Скопируй этот файл в config.env и заполни своими данными.
# НЕ коммить config.env в git! Добавь в .gitignore.
#
# Использование:
#   cp config.env.example config.env
#   # Заполни значения ниже
#   # Скрипты подхватят автоматически

# ═══════════════════════════════════════════════════════════════════════════════
# SSH доступ к серверу для хранения изображений
# ═══════════════════════════════════════════════════════════════════════════════
# Сервер, на который загружаются сгенерированные картинки и скриншоты.
# Должен быть доступен по SSH и иметь веб-сервер (nginx/apache) для отдачи файлов.
# Если вместо SSH используешь S3/R2 — оставь эти поля пустыми и адаптируй скрипты.

SSH_HOST="your-server.example.com"       # IP-адрес или домен сервера
SSH_USER="root"                           # SSH-пользователь (нужны права на запись в SERVER_IMG_PATH)
SSH_KEY_PATH="~/.ssh/id_rsa"             # Путь к приватному SSH-ключу (chmod 600!)

# ═══════════════════════════════════════════════════════════════════════════════
# Пути для хранения изображений
# ═══════════════════════════════════════════════════════════════════════════════
# SERVER_IMG_PATH — абсолютный путь на сервере, куда складывать картинки.
#   Должен быть доступен через веб-сервер (nginx location).
# IMG_BASE_URL — публичный URL этой папки (без trailing slash).
#   Используется в src/href картинок в статьях.

SERVER_IMG_PATH="/var/www/html/img/articles"              # Путь на сервере
IMG_BASE_URL="https://your-domain.ru/img/articles"        # Публичный URL

# ═══════════════════════════════════════════════════════════════════════════════
# Kie.ai — API для генерации изображений (Nano Banana 2)
# ═══════════════════════════════════════════════════════════════════════════════
# Получить ключ: https://kieai.erweima.ai/ (регистрация, ключ в личном кабинете)
# Модели: nano-banana-2 (основная), gemini-3-pro-image-preview, gemini-2.5-flash-image (фоллбеки)
# Скрипт автоматически перебирает модели если основная недоступна.

KIE_API_KEY="sk-your-kie-key-here"
KIE_BASE_URL="https://kieai.erweima.ai/api"               # Базовый URL (обычно не меняется)

# ═══════════════════════════════════════════════════════════════════════════════
# WordPress-площадки (для публикации в Дзен через RSS)
# ═══════════════════════════════════════════════════════════════════════════════
# Для каждой площадки создай тройку переменных: WP_XXX_URL, WP_XXX_USER, WP_XXX_PASS
# Имена переменных указываются в файлах projects/platforms/dzen-*.md
#
# Пример для площадки "Дзен МойПроект":
#   В файле projects/platforms/dzen-myproject.md указаны переменные:
#   WP_MYPROJECT_URL, WP_MYPROJECT_USER, WP_MYPROJECT_PASS
#
# Пароль — это Application Password из WordPress:
#   WP Admin -> Users -> Edit -> Application Passwords -> Add New
#   Формат: xxxx xxxx xxxx xxxx xxxx xxxx

# WP_MYPROJECT_URL="https://blog.myproject.ru"
# WP_MYPROJECT_USER="admin"
# WP_MYPROJECT_PASS="xxxx xxxx xxxx xxxx xxxx xxxx"

# Можно добавить сколько угодно площадок:
# WP_SECONDBLOG_URL="https://blog.secondproject.ru"
# WP_SECONDBLOG_USER="editor"
# WP_SECONDBLOG_PASS="yyyy yyyy yyyy yyyy yyyy yyyy"
